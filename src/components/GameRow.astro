---
import Icon from "./Icon.astro";
import { formatDate, gameOutcome, isoDate, ordinal, playerName, type Game, type Player } from "../utils/tournaments";
import { gameTitle, gameUrl, hasMoves } from "../utils/games";

interface Props {
    game: Game;
    team: boolean;
}

const { game, team } = Astro.props;
const { round, table, date, white, black, view } = game.data;
const outcome = gameOutcome(game);
const outcomeLabel = { win: "Win", loss: "Loss", draw: "Draw" }[outcome];

const sides: { color: "white" | "black"; player: Player }[] = [
    { color: "white", player: white },
    { color: "black", player: black },
];
---

<li class:list={["game", outcome, { playable: hasMoves(game) }]}>
    <p class="meta">
        <span>Round {round}</span>
        {table && <span>{ordinal(table)} board</span>}
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        {hasMoves(game) && (
            <a class="replay" href={gameUrl(game)} aria-label={`Replay ${gameTitle(game)}, round ${round}`}>
                Replay<Icon name="chevron-right" />
            </a>
        )}
    </p>
    <div class="players">
        {sides.map(({ color, player }) => (
            <p class:list={["player", { me: color === view }]}>
                <span class={`piece ${color}`} aria-label={color === "white" ? "White" : "Black"} role="img"></span>
                <span class="name">{playerName(player)}</span>
                <span class="elo">{player.elo > 0 ? player.elo : "unrated"}</span>
                {team && player.club && <span class="club">{player.club}</span>}
            </p>
        ))}
    </div>
    <p class="outcome">{outcomeLabel}</p>
</li>

<style>
    .game {
        display: grid;
        grid-template-columns: 1fr auto;
        grid-template-areas:
            "meta outcome"
            "players outcome";
        gap: 8px 16px;
        align-items: center;
        padding: 16px 0;
        border-bottom: 1px solid var(--border);
    }

    .game:last-child {
        border-bottom: 0;
    }

    .playable {
        position: relative;
        margin: 0 -12px;
        padding-right: 12px;
        padding-left: 12px;
        border-radius: 12px;
        transition: background-color 0.2s;
    }

    @media (hover: hover) {
        .playable:hover {
            background-color: var(--surface-2);
        }
    }

    .playable:has(.replay:focus-visible) {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
    }

    .replay {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        color: var(--accent);
        font-weight: 600;
        text-decoration: none;
    }

    .replay:focus-visible {
        outline: none;
    }

    .replay::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
    }

    .meta {
        grid-area: meta;
        display: flex;
        flex-wrap: wrap;
        gap: 4px 14px;
        margin: 0;
        color: var(--muted);
        font-size: 0.8125rem;
    }

    .players {
        grid-area: players;
        display: grid;
        gap: 4px;
    }

    .player {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px 10px;
        margin: 0;
        color: var(--muted);
    }

    .player.me .name {
        color: var(--text);
        font-weight: 600;
    }

    .piece {
        width: 10px;
        height: 10px;
        border: 1px solid var(--muted);
        border-radius: 3px;
    }

    .piece.white {
        background-color: #f3f5f8;
    }

    .piece.black {
        background-color: #1e2229;
    }

    .elo {
        font-size: 0.875rem;
        font-variant-numeric: tabular-nums;
    }

    .club {
        font-size: 0.8125rem;
    }

    .club::before {
        content: "· ";
    }

    .outcome {
        grid-area: outcome;
        min-width: 56px;
        margin: 0;
        padding: 4px 10px;
        border: 1px solid var(--border);
        border-radius: 999px;
        font-size: 0.8125rem;
        font-weight: 600;
        text-align: center;
    }

    .win .outcome {
        border-color: color-mix(in srgb, #2fa36b 45%, transparent);
        background-color: color-mix(in srgb, #2fa36b 14%, transparent);
        color: light-dark(#19764a, #5fd39a);
    }

    .loss .outcome {
        border-color: color-mix(in srgb, #d9534f 45%, transparent);
        background-color: color-mix(in srgb, #d9534f 12%, transparent);
        color: light-dark(#b23a36, #f08a86);
    }

    .draw .outcome {
        background-color: var(--surface-2);
        color: var(--muted);
    }
</style>
