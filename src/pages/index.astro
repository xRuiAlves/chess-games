---
import { getCollection } from "astro:content";

const tournaments = await getCollection("tournaments");
const games = await getCollection("games");
---

<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>Rui Alves · Chess</title>
    </head>
    <body>
        <h1>Chess</h1>
        <p>{tournaments.length} tournaments, {games.length} games</p>
    </body>
</html>
