---
import BaseLayout from "../layouts/BaseLayout.astro";
import Ratings from "../components/Ratings.astro";
import TournamentList from "../components/TournamentList.astro";
import { getTournaments } from "../utils/tournaments";
import { homeSchema } from "../utils/schema";

const tournaments = await getTournaments();
---

<BaseLayout jsonLd={homeSchema(Astro.site!, tournaments)}>
    <div class="container">
        <section class="intro">
            <h1>Chess</h1>
            <p class="lede">
                I'm <a href="https://ruialves.net/">Rui Alves</a>, and here you'll find (most of!) the tournaments I played throughout my "chess career".
            </p>
            <p class="lede follow">
                To play some games, reach out by <a href="mailto:rui@ruialves.net">email</a>.
                For more projects, chess-related or not, visit my <a href="https://github.com/xRuiAlves">GitHub</a>.
            </p>
        </section>
        <Ratings />
        <TournamentList />
    </div>
</BaseLayout>

<style>
    .intro {
        padding: 24px 0 0;
    }

    h1 {
        margin: 0;
        font-size: clamp(2.5rem, 7vw, 3.5rem);
        line-height: 1.05;
        letter-spacing: -0.035em;
    }

    .lede {
        margin: 16px 0 0;
        color: var(--muted);
        font-size: 1.125rem;
    }

    .follow {
        margin-top: 10px;
    }
</style>
