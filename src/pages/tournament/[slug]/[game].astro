---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Board from "../../../components/Board.astro";
import Icon from "../../../components/Icon.astro";
import { formatDate, gameOutcome, getGames, getTournaments, isoDate, ordinal, playerName, tournamentUrl, type Game, type Tournament } from "../../../utils/tournaments";
import { gameDescription, gameSlug, gameTitle, gameUrl, hasMoves, pgnFileName, replay, resultLabel } from "../../../utils/games";

export async function getStaticPaths() {
    const paths = [];
    for (const tournament of await getTournaments()) {
        const games = (await getGames(tournament)).filter(hasMoves);
        for (const [i, game] of games.entries()) {
            paths.push({
                params: { slug: tournament.id, game: gameSlug(game) },
                props: { game, tournament, prev: games[i - 1], next: games[i + 1] },
            });
        }
    }
    return paths;
}

interface Props {
    game: Game;
    tournament: Tournament;
    prev?: Game;
    next?: Game;
}

const { game, tournament, prev, next } = Astro.props;
const { round, table, date, white, black, view, lichess_url } = game.data;
const outcome = gameOutcome(game);
const outcomeLabel = { win: "Win", loss: "Loss", draw: "Draw" }[outcome];
const team = tournament.data.team;
const pgnUrl = `${gameUrl(game).replace(/\/$/, "")}.pgn`;
---

<BaseLayout title={`${gameTitle(game)} · ${tournament.data.name}`} description={gameDescription(game)}>
    <div class="container">
        <a class="back" href={tournamentUrl(tournament)}><Icon name="arrow-left" />{tournament.data.name}</a>
        <article class="game card">
            <header>
                <p class="meta">
                    <span>Round {round}</span>
                    {table && <span>{ordinal(table)} board</span>}
                    <time datetime={isoDate(date)}>{formatDate(date)}</time>
                </p>
                <h1>{gameTitle(game)}</h1>
                <div class="players">
                    {[
                        { color: "white", player: white },
                        { color: "black", player: black },
                    ].map(({ color, player }) => (
                        <p class:list={["player", { me: color === view }]}>
                            <span class={`piece ${color}`} role="img" aria-label={color === "white" ? "White" : "Black"}></span>
                            <span class="name">{playerName(player)}</span>
                            <span class="elo">{player.elo > 0 ? player.elo : "unrated"}</span>
                            {team && player.club && <span class="club">{player.club}</span>}
                        </p>
                    ))}
                    <p class={`outcome ${outcome}`}>{outcomeLabel} · {resultLabel(game)}</p>
                </div>
            </header>

            <Board replay={replay(game)} orientation={view} result={resultLabel(game)} />

            <div class="actions">
                <a href={pgnUrl} download={pgnFileName(game)}><Icon name="download" />Download PGN</a>
                <button type="button" data-copy-fen><Icon name="copy" /><span>Copy FEN</span></button>
                {lichess_url && <a href={lichess_url}><Icon name="external-link" />Analyse on Lichess</a>}
            </div>
            <p class="hint">Use the <kbd>←</kbd> and <kbd>→</kbd> keys to move through the game.</p>
        </article>

        {(prev || next) && (
            <nav class="pager" aria-label="More games from this tournament">
                {prev && (
                    <a class="card older" href={gameUrl(prev)} rel="prev">
                        <span class="label">Round {prev.data.round}</span>
                        <span class="pager-title">{gameTitle(prev)}</span>
                    </a>
                )}
                {next && (
                    <a class="card newer" href={gameUrl(next)} rel="next">
                        <span class="label">Round {next.data.round}</span>
                        <span class="pager-title">{gameTitle(next)}</span>
                    </a>
                )}
            </nav>
        )}
    </div>
</BaseLayout>

<script>
    const viewer = document.querySelector<HTMLElement>("[data-viewer]");
    const button = document.querySelector<HTMLButtonElement>("[data-copy-fen]");
    button?.addEventListener("click", async () => {
        const label = button.querySelector("span")!;
        try {
            await navigator.clipboard.writeText(viewer?.dataset.fen ?? "");
            label.textContent = "Copied";
        } catch {
            label.textContent = "Copy failed";
        }
        setTimeout(() => (label.textContent = "Copy FEN"), 1500);
    });
</script>

<style>
    .back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        max-width: 100%;
        margin: 8px 0 18px;
        color: var(--muted);
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
    }

    @media (hover: hover) {
        .back:hover {
            color: var(--text);
        }
    }

    .game {
        padding: clamp(20px, 5vw, 44px);
    }

    header {
        margin-bottom: 28px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--border);
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 14px;
        margin: 0;
        color: var(--muted);
        font-size: 0.9375rem;
    }

    h1 {
        margin: 8px 0 0;
        font-size: clamp(1.75rem, 5vw, 2.25rem);
        line-height: 1.15;
        letter-spacing: -0.03em;
        text-wrap: balance;
    }

    .players {
        display: grid;
        gap: 6px;
        margin-top: 16px;
    }

    .player {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px 10px;
        margin: 0;
        color: var(--muted);
    }

    .player.me .name {
        color: var(--text);
        font-weight: 600;
    }

    .piece {
        width: 10px;
        height: 10px;
        border: 1px solid var(--muted);
        border-radius: 3px;
    }

    .piece.white {
        background-color: #f3f5f8;
    }

    .piece.black {
        background-color: #1e2229;
    }

    .elo {
        font-size: 0.875rem;
        font-variant-numeric: tabular-nums;
    }

    .club {
        font-size: 0.8125rem;
    }

    .club::before {
        content: "· ";
    }

    .outcome {
        justify-self: start;
        margin: 6px 0 0;
        padding: 4px 12px;
        border: 1px solid var(--border);
        border-radius: 999px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .outcome.win {
        border-color: color-mix(in srgb, #2fa36b 45%, transparent);
        background-color: color-mix(in srgb, #2fa36b 14%, transparent);
        color: light-dark(#19764a, #5fd39a);
    }

    .outcome.loss {
        border-color: color-mix(in srgb, #d9534f 45%, transparent);
        background-color: color-mix(in srgb, #d9534f 12%, transparent);
        color: light-dark(#b23a36, #f08a86);
    }

    .outcome.draw {
        background-color: var(--surface-2);
        color: var(--muted);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 24px;
    }

    .actions a,
    .actions button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        background-color: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 10px;
        color: var(--text);
        font: inherit;
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        transition: border-color 0.2s, color 0.2s;
    }

    .actions :global(.icon) {
        color: var(--accent);
    }

    @media (hover: hover) {
        .actions a:hover,
        .actions button:hover {
            border-color: var(--accent);
        }
    }

    .hint {
        margin: 14px 0 0;
        color: var(--muted);
        font-size: 0.8125rem;
    }

    kbd {
        padding: 1px 6px;
        background-color: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 5px;
        font-family: inherit;
        font-size: 0.75rem;
    }

    .pager {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-top: 20px;
    }

    .pager a {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 18px 22px;
        color: var(--text);
        text-decoration: none;
        transition: border-color 0.2s, transform 0.2s;
    }

    .newer {
        grid-column: 2;
        text-align: right;
    }

    .label {
        color: var(--muted);
        font-size: 0.8125rem;
        font-weight: 500;
    }

    .pager-title {
        font-weight: 600;
        line-height: 1.4;
    }

    @media (hover: hover) {
        .pager a:hover {
            border-color: var(--accent);
            transform: translateY(-2px);
        }
    }

    @media (max-width: 600px) {
        .game {
            padding: 4px 0 0;
            background-color: transparent;
            border: 0;
            border-radius: 0;
            box-shadow: none;
        }

        .hint {
            display: none;
        }

        .pager {
            grid-template-columns: 1fr;
            gap: 0;
            margin-top: 32px;
            border-top: 1px solid var(--border);
        }

        .pager a {
            padding: 16px 0;
            background-color: transparent;
            border: 0;
            border-bottom: 1px solid var(--border);
            border-radius: 0;
            box-shadow: none;
        }

        .pager a:hover {
            transform: none;
        }

        .newer {
            grid-column: auto;
            text-align: left;
        }
    }
</style>
