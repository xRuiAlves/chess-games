---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameRow from "../../components/GameRow.astro";
import Icon from "../../components/Icon.astro";
import { formatDateRange, getGames, getTournaments, isoDate, ordinal, type Tournament } from "../../utils/tournaments";

export async function getStaticPaths() {
    const tournaments = await getTournaments();
    return tournaments.map((tournament) => ({ params: { slug: tournament.id }, props: { tournament } }));
}

interface Props {
    tournament: Tournament;
}

const { tournament } = Astro.props;
const t = tournament.data;
const games = await getGames(tournament);

const details = [
    ["Time control", t.timeControl],
    ["Format", t.team ? "Team" : "Individual"],
    ["Rated", t.rated ? "Yes" : "No"],
    ["Players", t.numPlayers],
    ["Rank", t.rank && (t.numPlayers ? `${ordinal(t.rank)} of ${t.numPlayers}` : ordinal(t.rank))],
    ["Score", t.score],
    ["Performance", t.performance],
    ["Rating change", t.ratingDiff],
].filter(([, value]) => value !== null && value !== undefined && value !== "");

const description = [
    `${t.name}: a ${t.category.toLowerCase()} ${t.team ? "team" : "individual"} chess tournament (${t.timeControl}) in ${t.location.name}, ${formatDateRange(t.date, t.finishDate)}.`,
    t.score ? `Rui Alves scored ${t.score}${t.rank && t.numPlayers ? `, ${ordinal(t.rank)} of ${t.numPlayers}` : ""}.` : "",
]
    .join(" ")
    .trim();
---

<BaseLayout title={t.name} description={description}>
    <div class="container">
        <a class="back" href="/"><Icon name="arrow-left" />All tournaments</a>
        <article class="tournament card">
            <header>
                <p class="meta">
                    <span class={`category ${t.category.toLowerCase()}`}>{t.category}</span>
                    <time datetime={isoDate(t.date)}>{formatDateRange(t.date, t.finishDate)}</time>
                </p>
                <h1>{t.name}</h1>
                <ul class="links">
                    <li><a href={t.location.gmaps}><Icon name="map-pin" />{t.location.name}</a></li>
                    {t.page && <li><a href={t.page}><Icon name="external-link" />Results page</a></li>}
                </ul>
            </header>

            <dl class="details">
                {details.map(([label, value]) => (
                    <div>
                        <dt>{label}</dt>
                        <dd>{value}</dd>
                    </div>
                ))}
            </dl>

            {t.notes && <p class="notes">{t.notes}</p>}

            <section class="games" aria-labelledby="games-title">
                <h2 id="games-title">Games</h2>
                {games.length > 0 ? (
                    <ol class="game-list">
                        {games.map((game) => <GameRow game={game} team={t.team} />)}
                    </ol>
                ) : (
                    <p class="empty">
                        {t.category === "Classic"
                            ? "There is no record of this tournament's games."
                            : `This is a ${t.category.toLowerCase()} tournament, and its games were not recorded.`}
                    </p>
                )}
            </section>
        </article>
    </div>
</BaseLayout>

<style>
    .back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 8px 0 18px;
        color: var(--muted);
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
    }

    @media (hover: hover) {
        .back:hover {
            color: var(--text);
        }
    }

    .tournament {
        padding: clamp(20px, 5vw, 44px);
    }

    header {
        padding-bottom: 24px;
        border-bottom: 1px solid var(--border);
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 12px;
        margin: 0;
        color: var(--muted);
        font-size: 0.9375rem;
    }

    .category {
        padding: 2px 10px;
        background-color: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--accent);
        font-size: 0.8125rem;
        font-weight: 600;
    }

    h1 {
        margin: 10px 0 0;
        font-size: clamp(1.875rem, 5vw, 2.5rem);
        line-height: 1.15;
        letter-spacing: -0.03em;
        text-wrap: balance;
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 20px;
        margin: 14px 0 0;
        padding: 0;
        list-style: none;
    }

    .links a {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--muted);
        font-size: 0.9375rem;
        text-decoration: none;
        transition: color 0.2s;
    }

    .links :global(.icon) {
        color: var(--accent);
    }

    @media (hover: hover) {
        .links a:hover {
            color: var(--text);
        }
    }

    .details {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 18px 16px;
        margin: 24px 0 0;
    }

    dt {
        color: var(--muted);
        font-size: 0.8125rem;
    }

    dd {
        margin: 2px 0 0;
        font-size: 1.0625rem;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    .notes {
        margin: 24px 0 0;
        padding: 14px 18px;
        background-color: var(--surface-2);
        border-left: 3px solid var(--accent);
        border-radius: 10px;
        color: var(--muted);
        line-height: 1.65;
    }

    .games {
        margin-top: 32px;
    }

    h2 {
        margin: 0 0 16px;
        color: var(--muted);
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .game-list {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .empty {
        margin: 0;
        color: var(--muted);
    }

    @media (max-width: 600px) {
        .tournament {
            padding: 4px 0 0;
            background-color: transparent;
            border: 0;
            border-radius: 0;
            box-shadow: none;
        }

        .notes {
            padding: 12px 14px;
        }
    }
</style>
