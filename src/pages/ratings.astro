---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { FIDE_ID } from "../consts";
import { formatDate, formatMonthYear, isoDate } from "../utils/tournaments";
import { getFideRatings, ratingsDate } from "../utils/ratings";

const fide = await getFideRatings();
const profileUrl = `https://ratings.fide.com/profile/${FIDE_ID}`;

// Points for the standard rating chart, oldest first
const points = (fide?.history ?? []).filter((entry) => entry.standard).toReversed();
const W = 720;
const H = 220;
const PAD = { top: 16, right: 12, bottom: 28, left: 44 };
const values = points.map((p) => p.standard!);
const min = Math.floor((Math.min(...values) - 20) / 50) * 50;
const max = Math.ceil((Math.max(...values) + 20) / 50) * 50;
const x = (i: number) => PAD.left + (i / Math.max(points.length - 1, 1)) * (W - PAD.left - PAD.right);
const y = (v: number) => PAD.top + (1 - (v - min) / (max - min)) * (H - PAD.top - PAD.bottom);
const line = points.map((p, i) => `${i ? "L" : "M"}${x(i).toFixed(1)} ${y(p.standard!).toFixed(1)}`).join(" ");
const area = points.length ? `${line} L${x(points.length - 1).toFixed(1)} ${H - PAD.bottom} L${x(0).toFixed(1)} ${H - PAD.bottom} Z` : "";
const ticks = Array.from({ length: (max - min) / 50 + 1 }, (_, i) => min + i * 50).filter((_, i, all) => all.length <= 6 || i % 2 === 0);
const years = points
    .map((p, i) => ({ i, year: p.period.getUTCFullYear(), month: p.period.getUTCMonth() }))
    .filter((p) => p.month === 0);
---

<BaseLayout
    title="Ratings"
    description={fide
        ? `FIDE rating history of Rui Alves (FIDE ID ${FIDE_ID}): standard ${fide.current.standard}, rapid ${fide.current.rapid}, blitz ${fide.current.blitz}. Highest standard rating ${fide.highestStandard.standard}.`
        : `FIDE rating history of Rui Alves (FIDE ID ${FIDE_ID}).`}
>
    <div class="container">
        <a class="back" href="/"><Icon name="arrow-left" />All tournaments</a>
        <section class="intro">
            <h1>Ratings</h1>
            <p class="lede">
                My monthly FIDE ratings, as published on the <a href={profileUrl}>FIDE profile</a>. Updated on {formatDate(ratingsDate)}.
            </p>
        </section>

        {fide ? (
            <>
                <figure class="card chart">
                    <figcaption>
                        <span>Standard rating</span>
                        <span class="peak">Highest: <strong>{fide.highestStandard.standard}</strong> in {formatMonthYear(fide.highestStandard.period)}</span>
                    </figcaption>
                    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Standard rating from ${values[0]} in ${formatMonthYear(points[0].period)} to ${values.at(-1)} in ${formatMonthYear(points.at(-1)!.period)}`}>
                        {ticks.map((t) => (
                            <g class="grid">
                                <line x1={PAD.left} x2={W - PAD.right} y1={y(t)} y2={y(t)} />
                                <text x={PAD.left - 8} y={y(t)} dy="0.32em" text-anchor="end">{t}</text>
                            </g>
                        ))}
                        {years.map((p) => (
                            <text class="year" x={x(p.i)} y={H - 8} text-anchor="middle">{p.year}</text>
                        ))}
                        <path class="area" d={area} />
                        <path class="line" d={line} />
                        <circle class="dot" cx={x(points.length - 1)} cy={y(values.at(-1)!)} r="4" />
                    </svg>
                </figure>

                <div class="card table-card">
                    <table>
                        <caption class="visually-hidden">FIDE ratings by month</caption>
                        <thead>
                            <tr>
                                <th scope="col">Month</th>
                                <th scope="col">Standard</th>
                                <th scope="col">Rapid</th>
                                <th scope="col">Blitz</th>
                            </tr>
                        </thead>
                        <tbody>
                            {fide.history.map((entry) => (
                                <tr>
                                    <th scope="row"><time datetime={isoDate(entry.period).slice(0, 7)}>{formatMonthYear(entry.period)}</time></th>
                                    <td>{entry.standard ?? "–"}</td>
                                    <td>{entry.rapid ?? "–"}</td>
                                    <td>{entry.blitz ?? "–"}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </>
        ) : (
            <p class="unavailable">The rating history is unavailable right now. See the <a href={profileUrl}>FIDE profile</a>.</p>
        )}
    </div>
</BaseLayout>

<style>
    .back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 8px 0 8px;
        color: var(--muted);
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
    }

    @media (hover: hover) {
        .back:hover {
            color: var(--text);
        }
    }

    .intro {
        padding: 16px 0 24px;
    }

    h1 {
        margin: 0;
        font-size: clamp(2.5rem, 7vw, 3.5rem);
        line-height: 1.05;
        letter-spacing: -0.035em;
    }

    .lede {
        max-width: 62ch;
        margin: 16px 0 0;
        color: var(--muted);
        font-size: 1.125rem;
    }

    .chart {
        margin: 0;
        padding: 22px 24px 16px;
    }

    figcaption {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 4px 16px;
        margin-bottom: 12px;
        font-weight: 600;
    }

    .peak {
        color: var(--muted);
        font-size: 0.9375rem;
        font-weight: 400;
    }

    .peak strong {
        color: var(--text);
    }

    svg {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }

    .grid line {
        stroke: var(--border);
        stroke-dasharray: 3 4;
    }

    .grid text,
    .year {
        fill: var(--muted);
        font-size: 12px;
        font-variant-numeric: tabular-nums;
    }

    .area {
        fill: color-mix(in srgb, var(--accent) 14%, transparent);
    }

    .line {
        fill: none;
        stroke: var(--accent);
        stroke-width: 2.5;
        stroke-linejoin: round;
        stroke-linecap: round;
    }

    .dot {
        fill: var(--accent);
        stroke: var(--surface);
        stroke-width: 2;
    }

    .table-card {
        margin-top: 14px;
        padding: 8px 24px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-variant-numeric: tabular-nums;
    }

    th,
    td {
        padding: 11px 8px;
        border-bottom: 1px solid var(--border);
        text-align: right;
    }

    th:first-child {
        padding-left: 0;
        text-align: left;
    }

    th:last-child,
    td:last-child {
        padding-right: 0;
    }

    thead th {
        color: var(--muted);
        font-size: 0.8125rem;
        font-weight: 600;
    }

    tbody th {
        font-weight: 500;
    }

    tbody tr:last-child > * {
        border-bottom: 0;
    }

    .unavailable {
        color: var(--muted);
    }

    @media (max-width: 600px) {
        .chart,
        .table-card {
            padding-right: 0;
            padding-left: 0;
            background-color: transparent;
            border: 0;
            border-radius: 0;
            box-shadow: none;
        }

        .table-card {
            border-top: 1px solid var(--border);
        }

        .grid text,
        .year {
            font-size: 22px;
        }

        .grid:nth-of-type(even) text {
            display: none;
        }

        .line {
            stroke-width: 4;
        }

        .dot {
            r: 6;
        }
    }
</style>
